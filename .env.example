# =========================================================================
# ALL INDIA COUNCIL FOR TECHNICAL EDUCATION (AICTE) - SIH 2026
# Master System Environment & Cryptographic Security Template (.env.example)
# =========================================================================

# 1. CORE SERVER RUNTIME & CLUSTER AUTO-SCALING
PORT=3000
NODE_ENV=production
APP_NAME="AICTE Integrated Institution Complaint & Overlap System"
APP_VERSION="2026.1.0-SIH"
CLUSTER_ENABLED=true
CLUSTER_WORKERS=4
HOST="0.0.0.0"

# 2. MYSQL 8.0 RELATIONAL STORAGE ENGINE
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=storage
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# 3. HIGH-SPEED REDIS CACHE & DISTRIBUTED KV STORE
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=300
REDIS_KEY_PREFIX=aicte:cache:

# 4. APACHE KAFKA DISTRIBUTED EVENT STREAMING PIPELINE
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=aicte-monitoring-engine
KAFKA_GROUP_ID=aicte-grievance-group
KAFKA_TOPIC_GRIEVANCE=aicte.grievance.submitted
KAFKA_TOPIC_OVERLAP=aicte.overlap.detected
KAFKA_TOPIC_ACTION=aicte.action.logged

# 5. ENTERPRISE AES-256-GCM PII ENCRYPTION ENGINE
ENCRYPTION_MASTER_KEY=your_32_byte_hex_encryption_key_here
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_IV_LENGTH=12
ENCRYPTION_SALT_ROUNDS=12

# 6. AUTHENTICATION, JWT & SESSION SECURITY
JWT_SECRET=your_jwt_secret_token_here
JWT_EXPIRATION="7d"
SESSION_SECRET=your_session_secret_seed_here
BCRYPT_SALT_ROUNDS=10

# 7. AICTE EXTERNAL GATEWAYS & PROTECTED API INTEGRATIONS
AICTE_REGISTRY_API_KEY=your_aicte_registry_api_key
AICTE_REGISTRY_URL="https://api.aicte-india.org/v2/institutions"
DIGILOCKER_INTEGRATION_KEY=your_digilocker_key
SMS_GATEWAY_AUTH_TOKEN=your_sms_gateway_token
INTERNAL_PII_PROTECTION=STRICT_AES256_GCM
